# ==============================================================================
#  CONFIGURAÇÃO UNIVERSAL — cv_robot.py
#  Compatível com ROS 1 (Noetic) e ROS 2 (Humble / Iron)
#
#  Para usar em um novo robô: preencha apenas o BLOCO 1 abaixo.
#  O código detecta automaticamente qual versão do ROS está instalada.
# ==============================================================================


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  BLOCO 1 — TROCAR PARA CADA ROBÔ  (único bloco obrigatório)              ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# Nome do robô (só para referência, não afeta o código)
ROBO_NOME=cuscobot

# --- SSH ---
ROBOT_SSH_HOST=192.168.1.10
ROBOT_SSH_USER=ubuntu
ROBOT_SSH_PASS=cuscobot
TURTLEBOT_PASS=turtlebot

# --- Câmera RTSP ---
# Formato: rtsp://usuario:senha@IP:porta/caminho
RTSP_URL=rtsp://admin:nupedee7@192.168.1.4:554/cam/realmonitor?channel=1&subtype=1&proto=Onvif

# --- Distância física entre os dois marcadores verdes do robô (medir com régua) ---
DIST_MARCADORES_CM=18.0
CENTER_OFFSET_FWD_CM=0.0
CENTER_OFFSET_LEFT_CM=0.0
HOMOGRAPHY_PKL=homografia_plano.pkl
HOMOGRAPHY_FORCE=true
# --- Calibração de visão ---
# Enquanto não calibrou: deixe 0.0 e 1.0
# Após calibrar: copie os valores da linha do log:
#   "[INFO] Alinhamento vis→odom aceito: s=X, rot=Y°"
#   VIS_FRAME_ROT_DEG = valor de "rot" (pode ser negativo)
#   VIS_FRAME_SCALE   = valor de "s"
VIS_FRAME_ROT_DEG=0.0
VIS_FRAME_SCALE=1.0

# --- Orientação da câmera ---
# Se a trajetória aparecer espelhada no gráfico, ative um ou os dois
VIS_FLIP_X=false
VIS_FLIP_Y=false


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  BLOCO 2 — VERSÃO DO ROS                                               ║
# ║                                                                         ║
# ║  O código tenta ROS 2 primeiro e cai para ROS 1 automaticamente.       ║
# ║  Configure apenas a seção da sua versão. A outra pode deixar como está.║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── ROS 2 (Humble / Iron) ────────────────────────────────────────────────────

# Domain ID deve ser igual ao configurado no robô (padrão ROS 2 é 0)
ROS_DOMAIN_ID=30

# 0 = enxerga tópicos na rede (necessário para robô remoto)
# 1 = só enxerga tópicos locais (usar apenas se robô e PC forem a mesma máquina)
ROS_LOCALHOST_ONLY=0

# Tópicos ROS 2
ROS2_ODOM_TOPIC=/odom
ROS2_CMD_VEL_TOPIC=/cmd_vel

# Opcional: força implementação DDS (deixar comentado para usar o padrão do sistema)
# RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# ── ROS 1 (Noetic) ───────────────────────────────────────────────────────────
# Só tem efeito se ROS 2 não estiver disponível no ambiente.

# Endereço do ROS Master — normalmente o IP do robô na porta 11311
ROS_MASTER_URI=http://192.168.1.10:11311

# IP desta máquina visível pelo robô (necessário para comunicação bidirecional)
# Se estiver rodando direto no robô, coloque o mesmo IP do robô
ROS_IP=192.168.1.10

# Tópicos ROS 1
ROS1_ODOM_TOPIC=/odom
ROS1_CMD_VEL_TOPIC=/cmd_vel

# Tópico genérico — usado pelo código se os específicos acima não estiverem definidos
# Não precisa mudar se os tópicos do ROS 1 e ROS 2 forem iguais
ROS_ODOM_TOPIC=/odom
ROS_CMD_VEL_TOPIC=/cmd_vel


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  BLOCO 3 — CÂMERA / RTSP  (raramente precisa mudar)                    ║
# ╚══════════════════════════════════════════════════════════════════════════╝

RTSP_TRANSPORT=tcp
RTSP_BUFFER_FRAMES=4
RTSP_OPEN_TIMEOUT_MS=7000
RTSP_READ_TIMEOUT_MS=7000
RTSP_FFMPEG_BUFFER_SIZE=1048576
RTSP_FFMPEG_MAX_DELAY_MS=500
RTSP_FFMPEG_STIMEOUT_MS=7000
RTSP_FFMPEG_REORDER_QUEUE_SIZE=0
FFMPEG_DISCARD_CORRUPT=1
FFMPEG_LOW_DELAY=0


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  BLOCO 4 — TRAJETÓRIA QUADRADA  (mudar conforme o teste)               ║
# ╚══════════════════════════════════════════════════════════════════════════╝

SQUARE_TRAJ_ENABLE=true
SQUARE_TRAJ_AUTO_START=true

# Tamanho do quadrado em cm
SQUARE_SIDE_CM=100

# Velocidade linear (m/s) — não passar de 0.15 para não perder os marcadores
SQUARE_LINEAR_MPS=0.10

# Tempo de reta em segundos (calculado automaticamente por SIDE_CM/LINEAR_MPS se omitido)
SQUARE_FORWARD_S=10.0

# Tempo de curva — ajustar até o robô girar exatamente 90°
SQUARE_LEFT_TURN_S=4.0

SQUARE_TURN_ANGLE_DEG=90.0
SQUARE_NUM_SIDES=4
SQUARE_START_DELAY_S=1.5

# Correção de heading nas retas (0 = desabilita)
SQUARE_HEADING_KP=0.5
SQUARE_HEADING_MAX_FRAC=0.10

# Usa visão para encerrar fases — deixar false até a visão estar calibrada
SQUARE_USE_VISION=false


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  BLOCO 5 — FUSÃO VISÃO + ODOMETRIA  (ajuste fino, mexer com cuidado)   ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# Aceita alinhamento vis→odom com RMSE até este valor (cm)
ALIGN_RMSE_MAX_CM=50.0

# Descarta saltos de visão maiores que este valor entre frames (cm)
MAX_SALTO_VISAO_CM=10.0

# Descarta correção de visão se ela estiver mais longe que isto da predição (cm)
VIS_CORRECAO_MAX_GAP_CM=6.0

# Peso da visão na fusão (0 = só odom, 1 = só visão) — valor baixo = mais suave
VIS_CORRECAO_BETA=0.15

# Pausa a correção de visão durante curvas acima deste ângulo por frame (graus)
VIS_CORRECAO_PAUSA_CURVA_DEG=5.0


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  BLOCO 6 — SAÍDA / DEBUG  (raramente precisa mudar)                    ║
# ╚══════════════════════════════════════════════════════════════════════════╝

SHOW_MASK=true
SAVE_CSV=false
PLOT_TRAJETORIA=true
PLOT_SAVE_PATH=trajetoria_xy_theta.png
QT_QPA_PLATFORM=xcb
HEADLESS=true
